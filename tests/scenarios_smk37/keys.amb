# the SMK-37 Elite's 37 keys, C3..C6 (keys 0..36): AISLING plays the middle 27, F3..G5 (keys 5..31, the FM-1's 0..26;
# tests/smk37_scenario.py plays every FM-1 scenario so); the five below and the five above are read and play nothing:
# no note out, the Lead's last note as it was, no key lit
wait 500
expect lastnote_ch3 0
# the five below (C3..E3), one at a time, then held together: nothing; E3 held does not light F3 (key 5, the app's 0)
peakreset
tapkey 0
tapkey 1
tapkey 2
tapkey 3
tapkey 4
key w0 down
key b0 down
key w1 down
key b1 down
key w2 down
wait 300
expect notes_ch3 0
expect lastnote_ch3 0
expect litkey0 0
key w0 up
key b0 up
key w1 up
key b1 up
key w2 up
wait 300
# the lowest key played, F3 (w3): the Lead's lowest (the scale's root, D4 in the first piece, as the FM-1's key 0)
peakreset
key w3 down
wait 300
expect notes_ch3 1
expect lastnote_ch3 62
expect litkey0 1
key w3 up
wait 300
# the highest, G5 (key 31, w18: the FM-1's key 26)
key 31 down
wait 300
expect notes_ch3 2
expect lastnote_ch3 88
expect litkey26 1
key 31 up
wait 300
# the five above (G#5..C6): nothing; G#5 held does not light G5
peakreset
tapkey 32
tapkey 33
tapkey 34
tapkey 35
tapkey 36
key b13 down
key w19 down
key b14 down
key w20 down
key w21 down
wait 300
expect notes_ch3 0
expect lastnote_ch3 88
expect litkey26 0
key b13 up
key w19 up
key b14 up
key w20 up
key w21 up
wait 300
# a finger across all 22 white keys: the 16 in the middle play (the FM-1's 16 white keys)
peakreset
strum 0 21
wait 300
expect notes_ch3 16
